# Development environment variables for PostgreSQL database
POSTGRES_DB=electTN
POSTGRES_USER=electTN
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgres://electTN:devpassword@localhost/electTN?sslmode=disable

# Application settings
APP_MODE=development
PORT=8080
SESSION_SECRET=dev-secret-change-in-production

# Generic OpenID Connect provider (supports Google, Keycloak, Authentik, Zitadel, Auth0, ...)
# Set OIDC_ISSUER to enable generic OIDC. Leave it empty to use the legacy Google
# configuration via the GOOGLE_* variables below.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
OIDC_SCOPES=openid,email,profile
# Optional overrides
# OIDC_PROVIDER_NAME=Keycloak
# OIDC_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration
# OIDC_AUTHORIZATION_URL=https://id.example.com/auth
# OIDC_TOKEN_URL=https://id.example.com/token
# OIDC_USERINFO_URL=https://id.example.com/userinfo
# OIDC_AUTH_STYLE=auto            # auto | in_header | in_params
# OIDC_REQUIRE_VERIFIED_EMAIL=false

# Legacy Google OAuth (used when OIDC_ISSUER is empty)
GOOGLE_CLIENT_ID=your-google-oauth2-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth2-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback

# Deprecated: use OIDC_SCOPES
GOOGLE_SCOPES=email,profile
OAUTH_STATE_EXPIRY=300
